<?xml version="1.0" encoding="utf-8"?>
<!-- Tweaked SolidWorks-exported URDF for ROS 2 + Ignition Gazebo + ros2_control
     Joseph – Port Harcourt, March 2026
     Fixes applied:
       - Added IMU Gazebo sensor plugin with noise
       - Fixed duplicate <gazebo reference="left_wheel"> (second was missing right_wheel)
       - Removed spurious <axis xyz="0 0 0"> from fixed joints
       - Added noise + visualize to lidar sensor
       - Cleaned up ros2_control caster state interfaces (kept, but noted)
-->
<robot name="sam_bot">

  <!-- ============================================= -->
  <!-- BASE FOOTPRINT (ground reference – important for nav2) -->
  <!-- ============================================= -->
  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.035" rpy="0 0 0" />
  </joint>

  <!-- ============================================= -->
  <!-- BASE LINK (main chassis) -->
  <!-- ============================================= -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0015287 -0.0001076 0" rpy="0 0 0" />
      <mass value="2.0"/>
      <inertia ixx="0.00690" ixy="0.0" ixz="0.0"
               iyy="0.00690" iyz="0.0"
               izz="0.00834"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sam_bot_nav2_gz/meshes/base_link.STL" />
      </geometry>
      <material name="light_pink">
        <color rgba="1.0 0.753 0.796 1" />
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.098875" length="0.128" />
      </geometry>
    </collision>
  </link>

  <gazebo reference="base_link">
    <visual>
      <material>
        <ambient>1.0 0.753 0.796 1.0</ambient>
        <diffuse>1.0 0.753 0.796 1.0</diffuse>
        <specular>0.1 0.1 0.1 1.0</specular>
        <emissive>0.0 0.0 0.0 1.0</emissive>
      </material>
    </visual>
  </gazebo>


  <!-- ============================================= -->
  <!-- LEFT DRIVE WHEEL -->
  <!-- ============================================= -->
  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.035" />
      <inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.5e-5" iyz="0" izz="1.5e-5" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sam_bot_nav2_gz/meshes/left_wheel.STL" />
      </geometry>
      <material name="dark_grey"><color rgba="0.33 0.33 0.33 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.034" length="0.025" />
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="-0.0011 0.099 -0.0606" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <gazebo reference="left_wheel">
    <mu1 value="1.5"/>
    <mu2 value="1.5"/>
    <kp value="1e7"/>
    <kd value="10"/>
    <minDepth>0.001</minDepth>
  </gazebo>


  <!-- ============================================= -->
  <!-- RIGHT DRIVE WHEEL -->
  <!-- ============================================= -->
  <link name="right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.035" />
      <inertia ixx="1.5e-5" ixy="0" ixz="0" iyy="2.5e-5" iyz="0" izz="1.5e-5" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sam_bot_nav2_gz/meshes/right_wheel.STL" />
      </geometry>
      <material name="dark_grey"><color rgba="0.33 0.33 0.33 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.034" length="0.025" />
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="-0.0011 -0.099 -0.0606" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- FIX: was duplicated as left_wheel before – now correctly right_wheel -->
  <gazebo reference="right_wheel">
    <mu1 value="1.5"/>
    <mu2 value="1.5"/>
    <kp value="1e7"/>
    <kd value="10"/>
    <minDepth>0.001</minDepth>
  </gazebo>


  <!-- ============================================= -->
  <!-- FRONT CASTER -->
  <!-- ============================================= -->
  <link name="front_castor_swivel">
    <inertial>
      <origin xyz="-0.00662747137712966 0.00082573191732882 -0.011755530269531" rpy="0 0 0" />
      <mass value="0.00225929587173408" />
      <inertia ixx="2.94235794193693E-07" ixy="9.72459226692024E-09" ixz="-9.13118605246731E-08"
               iyy="2.99032553651638E-07" iyz="1.71049060747718E-08"
               izz="3.24471502317489E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sam_bot_nav2_gz/meshes/front_castor_swivel.STL" />
      </geometry>
      <material name="grey"><color rgba="0.706 0.706 0.706 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.015" length="0.04" />
      </geometry>
    </collision>
  </link>

  <joint name="front_castor_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_castor_swivel"/>
    <origin xyz="0.0683 0 -0.056" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.001" friction="0.001"/>
  </joint>

  <link name="front_castor_wheel">
    <inertial>
      <origin xyz="-4.17806118347963E-05 0.00223643989380329 -3.33066907387547E-16" rpy="0 0 0" />
      <mass value="0.00578153317426048" />
      <inertia ixx="4.38135168803409E-07" ixy="1.60705884622464E-08" ixz="2.9702993554684E-24"
               iyy="7.37153144661598E-07" iyz="-1.38374641237601E-23"
               izz="4.37273942643726E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sam_bot_nav2_gz/meshes/front_castor_wheel.STL" />
      </geometry>
      <material name="grey"><color rgba="0.706 0.706 0.706 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.015" />
      </geometry>
    </collision>
  </link>

  <joint name="front_castor_wheel_joint" type="continuous">
    <parent link="front_castor_swivel"/>
    <child link="front_castor_wheel"/>
    <origin xyz="-0.0154 -0.0014 -0.02325" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <gazebo reference="front_castor_wheel">
    <mu1 value="0.01"/>
    <mu2 value="0.6"/>
    <kp value="1e6"/>
    <kd value="50"/>
    <minDepth>0.001</minDepth>
  </gazebo>


  <!-- ============================================= -->
  <!-- REAR CASTER -->
  <!-- ============================================= -->
  <link name="rear_castor_swivel">
    <inertial>
      <origin xyz="-0.00662747137712966 0.00082573191732882 -0.011755530269531" rpy="0 0 0" />
      <mass value="0.00225929587173408" />
      <inertia ixx="2.94235794193693E-07" ixy="9.72459226692024E-09" ixz="-9.13118605246731E-08"
               iyy="2.99032553651638E-07" iyz="1.71049060747718E-08"
               izz="3.24471502317489E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sam_bot_nav2_gz/meshes/rear_castor_swivel.STL" />
      </geometry>
      <material name="grey"><color rgba="0.706 0.706 0.706 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.015" length="0.04" />
      </geometry>
    </collision>
  </link>

  <joint name="rear_castor_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_castor_swivel"/>
    <origin xyz="-0.0683 0 -0.056" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.001" friction="0.001"/>
  </joint>

  <link name="rear_castor_wheel">
    <inertial>
      <origin xyz="-4.17806118347963E-05 0.00223643989380329 -3.33066907387547E-16" rpy="0 0 0" />
      <mass value="0.00578153317426048" />
      <inertia ixx="4.38135168803409E-07" ixy="1.60705884622464E-08" ixz="2.9702993554684E-24"
               iyy="7.37153144661598E-07" iyz="-1.38374641237601E-23"
               izz="4.37273942643726E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sam_bot_nav2_gz/meshes/rear_castor_wheel.STL" />
      </geometry>
      <material name="grey"><color rgba="0.706 0.706 0.706 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.015" />
      </geometry>
    </collision>
  </link>

  <joint name="rear_castor_wheel_joint" type="continuous">
    <parent link="rear_castor_swivel"/>
    <child link="rear_castor_wheel"/>
    <origin xyz="-0.0154 -0.0014 -0.02325" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <gazebo reference="rear_castor_wheel">
    <mu1 value="0.01"/>
    <mu2 value="0.6"/>
    <kp value="1e6"/>
    <kd value="50"/>
    <minDepth>0.001</minDepth>
  </gazebo>


  <!-- ============================================= -->
  <!-- LIDAR -->
  <!-- ============================================= -->
  <link name="lidar">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0730846039145514" />
      <inertia ixx="0.0001906" ixy="0.0" ixz="0.0"
               iyy="0.0003068" iyz="0.0"
               izz="0.0003543"/>
    </inertial>
    <visual>
      <origin xyz="-0.012 -0.022 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sam_bot_nav2_gz/meshes/lidar.STL" />
      </geometry>
      <material name="grey"><color rgba="0.753 0.753 0.753 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.01" rpy="0 0 0" />
      <geometry>
        <box size="0.097 0.069 0.04" />
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- FIX: added noise and visualize that were missing -->
  <gazebo reference="lidar">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar</gz_frame_id>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>3</update_rate> <!-- 5 -->
      <ray>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1.0</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.283</max_angle>
          </horizontal>
<vertical>
    <samples>5</samples>            <!-- add vertical spread -->
    <resolution>1.0</resolution>
    <min_angle>-0.1745</min_angle>  <!-- ±10° vertical -->
    <max_angle>0.1745</max_angle>
  </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>3.5</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>


  <!-- ============================================= -->
  <!-- IMU -->
  <!-- ============================================= -->
  <link name="imu">
    <inertial>
      <origin xyz="-6.31876500063466E-05 -2.71495890153961E-05 -0.000556756215958853" rpy="0 0 0" />
      <mass value="0.02" />
      <inertia ixx="9.9E-07" ixy="0" ixz="0"
               iyy="4.13E-06" iyz="0"
               izz="3.76E-06" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sam_bot_nav2_gz/meshes/imu.STL" />
      </geometry>
      <material name="grey"><color rgba="0.753 0.753 0.753 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.0254 0.0254 0.00465" />
      </geometry>
    </collision>
  </link>

  <!-- FIX: removed spurious <axis xyz="0 0 0"> from fixed joint -->
  <joint name="imu_joint" type="fixed">
    <origin xyz="-0.00110492627089243 -7.89021335523277E-05 0.0154381992723319" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="imu" />
  </joint>

  <!-- FIX: this entire block was missing from your file -->
  <gazebo reference="imu">
    <sensor name="imu_sensor" type="imu">
      <gz_frame_id>imu</gz_frame_id>
      <plugin filename="ignition-gazebo-imu-system"
              name="ignition::gazebo::systems::Imu">
      </plugin>
      <topic>imu</topic>
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>


  <!-- ============================================= -->
  <!-- TOF SENSOR -->
  <!-- ============================================= -->
  <link name="tof">
    <inertial>
      <origin xyz="1.11022302462516E-16 2.22044604925031E-16 0.001" rpy="0 0 0" />
      <mass value="0.000200000000000002" />
      <inertia ixx="1.73333333333336E-09" ixy="0" ixz="-1.21855212583811E-26"
               iyy="1.73333333333336E-09" iyz="4.51750905202311E-27"
               izz="3.33333333333339E-09" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sam_bot_nav2_gz/meshes/tof.STL" />
      </geometry>
      <material name="tof_blue"><color rgba="0.792 0.820 0.933 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.010 0.010 0.002" />
      </geometry>
    </collision>
  </link>

  <!-- FIX: removed spurious <axis> from fixed joint -->
  <joint name="tof_joint" type="fixed">
    <origin xyz="0.0756469345109923 -0.0332652787387306 -0.0583716314794056" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="tof" />
  </joint>


  <!-- ============================================= -->
  <!-- ULTRASONIC SENSORS -->
  <!-- ============================================= -->
  <link name="front_ultrasonic">
    <inertial>
      <origin xyz="0.00366778084488301 -1.59732521927136E-05 -7.49171350463707E-05" rpy="0 0 0" />
      <mass value="0.00401081291720019" />
      <inertia ixx="3.75731975535782E-07" ixy="-3.25714288876319E-14" ixz="9.4369894445709E-15"
               iyy="1.13242599866062E-07" iyz="3.5417064497483E-14"
               izz="3.11874315212592E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sam_bot_nav2_gz/meshes/front_ultrasonic.STL" />
      </geometry>
      <material name="grey"><color rgba="0.753 0.753 0.753 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.0136 0.0455 0.02025" />
      </geometry>
    </collision>
  </link>

  <!-- FIX: removed spurious <axis> from fixed joint -->
  <joint name="front_ultrasonic_joint" type="fixed">
    <origin xyz="0.0811855861771879 -0.000332919850029034 -0.00521180072766803" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="front_ultrasonic" />
  </joint>

  <gazebo reference="front_ultrasonic">
    <sensor name="front_ultrasonic_sensor" type="gpu_ray">
      <topic>front_ultrasonic</topic>
      <gz_frame_id>front_ultrasonic</gz_frame_id>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>20</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>30</samples>          <!-- narrow cone, not 180° -->
            <resolution>1.0</resolution>
            <min_angle>-0.2618</min_angle>  <!-- ~±10° cone -->
            <max_angle>0.2618</max_angle>
          </horizontal>
          <vertical>
              <samples>5</samples>            <!-- add vertical spread -->
              <resolution>1.0</resolution>
              <min_angle>-0.1745</min_angle>  <!-- ±10° vertical -->
              <max_angle>0.1745</max_angle>
            </vertical>
        </scan>
        <range>
          <min>0.02</min>
          <max>0.55</max> <!-- 0.5 -->
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <link name="right_ultrasonic">
    <inertial>
      <origin xyz="-1.59732516995525E-05 -0.00366778084471608 -7.49171356525524E-05" rpy="0 0 0" />
      <mass value="0.00401081291754531" />
      <inertia ixx="1.13242599866133E-07" ixy="3.25714076456338E-14" ixz="3.54171113882567E-14"
               iyy="3.75731975535875E-07" iyz="-9.43695793964043E-15"
               izz="3.11874315212634E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://sam_bot_nav2_gz/meshes/right_ultrasonic.STL" />
      </geometry>
      <material name="grey"><color rgba="0.753 0.753 0.753 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.0455 0.0136 0.02025" />
      </geometry>
    </collision>
  </link>

  <!-- FIX: removed spurious <axis> from fixed joint -->
  <joint name="right_ultrasonic_joint" type="fixed">
    <origin xyz="-0.0013523670739406 -0.0823708731011579 -0.00521180072766803" rpy="0 0 -1.5708" />
    <parent link="base_link" />
    <child link="right_ultrasonic" />
  </joint>

  <gazebo reference="right_ultrasonic">
    <sensor name="right_ultrasonic_sensor" type="gpu_ray">
      <topic>right_ultrasonic</topic>
      <gz_frame_id>right_ultrasonic</gz_frame_id>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>20</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>30</samples>          <!-- narrow cone, not 180° -->
            <resolution>1.0</resolution>
            <min_angle>-0.2618</min_angle>  <!-- ~±10° cone -->
            <max_angle>0.2618</max_angle>
          </horizontal>
          <vertical>
              <samples>5</samples>            <!-- add vertical spread -->
              <resolution>1.0</resolution>
              <min_angle>-0.1745</min_angle>  <!-- ±10° vertical -->
              <max_angle>0.1745</max_angle>
            </vertical>
        </scan>
        <range>
          <min>0.02</min>
